# 🌸 BloomFocus Environment Variables
# Copy this file to .env and fill in your values for production

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="bloomfocus_super_secret_kawaii_key_at_least_32_characters_long_2026"

# Google OAuth 2.0 Credentials (From Google Cloud Console)
# Redirect URI: http://localhost:3000/api/auth/callback/google
# Production Redirect URI: https://your-domain.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# PostgreSQL Database Connection String (e.g., Neon.tech, Supabase, or AWS RDS)
# Free instant Neon PostgreSQL: https://neon.tech
DATABASE_URL="postgresql://postgres:password@ep-flower-sample.us-east-2.aws.neon.tech/bloomfocus?sslmode=require"
